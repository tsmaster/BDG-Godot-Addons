; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="MeatEngine"
run/main_scene="res://demo/retro_menu_demo.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/bdg_retro_menu/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")
